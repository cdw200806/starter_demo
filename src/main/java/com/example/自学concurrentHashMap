        /**
         * Possibly pops traversal state.
         *
         * @param n length of current table
         */
        private void recoverState(int n) {
            TableStack<K,V> s; int len;
            while ((s = stack) != null && (index += (len = s.length)) >= n) {//这个是判断是否已经到了顶层。以及低层中跳高位或者返回高层的代码。只要当前低层还能访问高位，就不会执行while循环体内的recover。刷index后在外层继续访问。当前低层已访问完毕时，再recover。
                n = len;//可能出现连续recover的情况，所以刷新一下n。
                index = s.index;//恢复 index
                tab = s.tab;//恢复 tab
                s.tab = null;//恢复完tab之后把对tab的引用置空。疑问是这个动作有何意义。由于forwardingNode的存在，tab指向的table是不可能被提前回收的。除非Traverser声明周期结束。
                TableStack<K,V> next = s.next;//恢复时，spare的引用链会变长。而s.next会成为新栈顶
                s.next = spare; // save for reuse   //这行代码其实和倒数第二行到换下，更好理解一点。这个是延长spare链。
                stack = next;//更新栈顶
                spare = s;//更新spare顶
            }
            if (s == null && (index += baseSize) >= n)//回到最顶层。且目前的index不正确。
                index = ++baseIndex;//刷新index的值到baseIndex+1。baseIndex的修改强绑定stack为null证明了只有在最顶层，也就是原始tab中，才会有index++的操作。
