    @SuppressWarnings("serial")
    static final class MapReduceMappingsTask<K,V,U>
        extends BulkTask<K,V,U> {
        final BiFunction<? super K, ? super V, ? extends U> transformer;
        final BiFunction<? super U, ? super U, ? extends U> reducer;
        U result;
        MapReduceMappingsTask<K,V,U> rights, nextRight;
        MapReduceMappingsTask
            (BulkTask<K,V,?> p, int b, int i, int f, Node<K,V>[] t,
             MapReduceMappingsTask<K,V,U> nextRight,
             BiFunction<? super K, ? super V, ? extends U> transformer,
             BiFunction<? super U, ? super U, ? extends U> reducer) {
            super(p, b, i, f, t); this.nextRight = nextRight;
            this.transformer = transformer;
            this.reducer = reducer;
        }//构造方法。包含 transformer, reducer等
        public final U getRawResult() { return result; }//立即获得结果
        public final void compute() {//继承于CountedCompleter必须要实现的方法。负责递归判断任务是否继续分解或直接执行。
            final BiFunction<? super K, ? super V, ? extends U> transformer;
            final BiFunction<? super U, ? super U, ? extends U> reducer;
            if ((transformer = this.transformer) != null &&
                (reducer = this.reducer) != null) {
                for (int i = baseIndex, f, h; batch > 0 &&
                         (h = ((f = baseLimit) + i) >>> 1) > i;) {//这个是ConcurrentHashMap作者沉迷于位运算。导致任务分割代码的可读性比较差。这里的batch是上层的reduce方法根据 batchFor(并发阈值){大概逻辑是总数/阈值=任务分解成多少组}计算而来。batch可以简单理解成任务分解成多少份。而这里在递归分解任务的时候，每次把batch右移一位，同时也触发任务减半。当batch右移没了，比如8在四轮减半变为0。此时任务也经过了四轮减半。单组任务分解成原来的1/16。
                    addToPendingCount(1);//此方法源于countedCompleter,代表待完成的任务加1。
                    (rights = new MapReduceMappingsTask<K,V,U>
                     (this, batch >>>= 1, baseLimit = h, f, tab,
                      rights, transformer, reducer)).fork();//头插。新建了个任务覆盖了当前的rights。让旧的变成当前nextRight。其中batch减半。进行了一次分治。
                }
                U r = null;
                for (Node<K,V> p; (p = advance()) != null; ) {//compute先判断能否继续分任务，不能则负责具体执行。这里开始遍历当前任务
                    U u;
                    if ((u = transformer.apply(p.key, p.val)) != null)
                        r = (r == null) ? u : reducer.apply(r, u);//map and reduce
                }
                result = r;//结果存于result
                CountedCompleter<?> c;
                for (c = firstComplete(); c != null; c = c.nextComplete()) {//后续单开讲解countedCompleter中的这两个方法。
                    @SuppressWarnings("unchecked")//返回null有两种情况，如果firstComplete就返回null，是说任务还没执行完。这样退出逻辑会转移到子任务中。如果nextComplete返回null。也可能是当前任务已经是顶级任务了，无需再进行最后的结果归并。另外nextComplete方法如果不是顶级任务， 会递归的调用父任务的firstComplete执行并返回。此时如果父任务没有完成，只要对父任务计数-1即可。相应的结束逻辑也会转移到其他线程。
                    MapReduceMappingsTask<K,V,U>
                        t = (MapReduceMappingsTask<K,V,U>)c,//c是代表当前焦点任务，且其子任务已经完成。
                        s = t.rights;//s是当前焦点的任务链，由于任务链是头插的，所以越往后越是父级任务。前面在分割任务的时候，把后半部分数据会分给其他任务，并且rights会更新成子任务。而子任务的nextRight是当前任务。形成一个任务链。
                    while (s != null) {当s还有父任务时
                        U tr, sr;
                        if ((sr = s.result) != null)//如果父任务结果不是null
                            t.result = (((tr = t.result) == null) ? sr :
                                        reducer.apply(tr, sr));//mapReduce的精髓就在于结果可以合并 这里是把当前焦点的一串任务结果都合并起来。合到t.result。也就是当前焦点任务的result。
                        s = t.rights = s.nextRight;//每次迭代，释放一个任务。
                    }
                }
            }
        }
    }

