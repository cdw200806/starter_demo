ConcurrentHashMap实现readObject。当 ObjectInputStream对象在执行readObject方法时，JVM底层执行是，根据流中的类信息，使用反射建立一个未初始化的ConcurrentHashMap对象，然后使用反射用这个对象来调用ConcurrentHashMap的readObject对象。最终完成反序列化。当然自己new一个ConcurrentHashMap对象，然后去调自己类的readObject。理论上也可行。

    /**
     * Reconstitutes this map from a stream (that is, deserializes it).
     * @param s the stream
     * @throws ClassNotFoundException if the class of a serialized object
     *         could not be found
     * @throws java.io.IOException if an I/O error occurs
     */
    private void readObject(java.io.ObjectInputStream s)
        throws java.io.IOException, ClassNotFoundException {

        /*
         * To improve performance in typical cases, we create nodes
         * while reading, then place in table once size is known.
         * However, we must also validate uniqueness and deal with
         * overpopulated bins while doing so, which requires
         * specialized versions of putVal mechanics.
         */
        sizeCtl = -1; // force exclusion for table construction
        //-1代表初始化中
        s.defaultReadObject();//只能在readObject方法中调用这个方法。
        //读取属于非静态的，属于实例的字段，且非transient的字段。
        long size = 0L;
        Node<K,V> p = null;
        for (;;) {
            @SuppressWarnings("unchecked")
            K k = (K) s.readObject();//使用readObject读key。因为可能切换了JVM需要重新Hash。
            @SuppressWarnings("unchecked")
            V v = (V) s.readObject();
            if (k != null && v != null) {
                p = new Node<K,V>(spread(k.hashCode()), k, v, p);//头插
                ++size;
            }
            else
                break;
        }
        if (size == 0L)
            sizeCtl = 0;
        else {
            long ts = (long)(1.0 + size / LOAD_FACTOR);//这个是为方便计算下容量
            int n = (ts >= (long)MAXIMUM_CAPACITY) ?
                MAXIMUM_CAPACITY : tableSizeFor((int)ts);//tableSizeFor保证结果是2的幂次。
            @SuppressWarnings("unchecked")
            Node<K,V>[] tab = (Node<K,V>[])new Node<?,?>[n];//初始化table
            int mask = n - 1;//掩码
            long added = 0L;//元素数量
            while (p != null) {//死循环
                boolean insertAtFront;//是否头插
                Node<K,V> next = p.next, first;
                int h = p.hash, j = h & mask;//此时的hash已经处理好了。h& n-1 其实就是桶位
                if ((first = tabAt(tab, j)) == null)//如果空童
                    insertAtFront = true;//头插
                else {
                    K k = p.key;
                    if (first.hash < 0) {//头小于零
                        TreeBin<K,V> t = (TreeBin<K,V>)first;//小于0直接认作TreeBin
                        if (t.putTreeVal(h, k, p.val) == null)//执行TreeBin的putTreeVal方法
                            ++added;//数量++
                        insertAtFront = false;//非头插
                    }
                    else {
                        int binCount = 0;
                        insertAtFront = true;//是数组，也要往头上插。
                        Node<K,V> q; K qk;
                        for (q = first; q != null; q = q.next) {
                            if (q.hash == h &&
                                ((qk = q.key) == k ||
                                 (qk != null && k.equals(qk)))) {
                                insertAtFront = false;//如果已经有了，直接处理下一个
                                break;
                            }
                            ++binCount;//如果当前没找到，当做binCount++
                        }
                        if (insertAtFront && binCount >= TREEIFY_THRESHOLD) {//头插，而且在找到元素时，bincount已经加到了8。
                            insertAtFront = false;//不头插了，要树化
                            ++added;//数量增加
                            p.next = first;
                            TreeNode<K,V> hd = null, tl = null;
                            for (q = p; q != null; q = q.next) {//所谓树化，就是建一堆用next连接的node。然后TreeBin的构造方法就能完成。
                                TreeNode<K,V> t = new TreeNode<K,V>
                                    (q.hash, q.key, q.val, null, null);//这个就是建node
                                if ((t.prev = tl) == null)//将t的前序设置为尾巴。如果之前就没有尾巴。
                                    hd = t;//t就是头
                                else
                                    tl.next = t;//否则在尾巴上续就行。
                                tl = t;//更新尾指针
                            }
                            setTabAt(tab, j, new TreeBin<K,V>(hd));//树化并置于桶。
                        }
                    }
                }
                if (insertAtFront) {//头插代码复用
                    ++added;//加数目
                    p.next = first;//头插
                    setTabAt(tab, j, p);//置于桶上
                }
                p = next;//循环的迭代表达式
            }
            table = tab;//设置table
            sizeCtl = n - (n >>> 2);//sizeCtl常态下是下次扩容时的阈值。
            baseCount = added;//更新计数，直接使用baseCount。
        }
    }

