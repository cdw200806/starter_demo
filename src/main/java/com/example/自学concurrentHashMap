     * or {@code null} if this map contains no mapping for the key.
     *
     * <p>More formally, if this map contains a mapping from a key
     * {@code k} to a value {@code v} such that {@code key.equals(k)},
     * then this method returns {@code v}; otherwise it returns
     * {@code null}.  (There can be at most one such mapping.)
     *
     * @throws NullPointerException if the specified key is null
     */
    public V get(Object key) {
        Node<K,V>[] tab; Node<K,V> e, p; int n, eh; K ek;
        int h = spread(key.hashCode());//扰动函数，与put对应
        if ((tab = table) != null && (n = tab.length) > 0 &&
            (e = tabAt(tab, (n - 1) & h)) != null) {//正常情况下是能找到对应的格子的
            if ((eh = e.hash) == h) {//发现hash相同。那么比较一下key是否equals.
                if ((ek = e.key) == key || (ek != null && key.equals(ek)))
                    return e.val;
            }
            else if (eh < 0)//如果小于0。可能是-1 moved->forwarding node.  -2 TreeBin 是红黑树  -3 RESERVED 只有在compute 或者computeifAbsent的时候，并且空槽。才会放一个-3占位+CAS。(computeIfPresent自然不会遇到操作空槽，所以不会使用ReservationNode)
                return (p = e.find(h, key)) != null ? p.val : null;//小于0，直接查。TreeBin/ForwardingNode/ReservationNode都实现了自己的find。其中ReservationNode最简单，直接返回null。
            while ((e = e.next) != null) {//当>=0。直接普通链表方式遍历
                if (e.hash == h &&
                    ((ek = e.key) == key || (ek != null && key.equals(ek))))
                    return e.val;//找到就返回，没有就是null
            }
        }
