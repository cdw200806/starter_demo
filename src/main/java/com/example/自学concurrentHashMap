        /**
         * Saves traversal state upon encountering a forwarding node.
         */
        private void pushState(Node<K,V>[] t, int i, int n) {
            TableStack<K,V> s = spare;  // reuse if possible
            if (s != null)//复用spare对象
                spare = s.next;
            else
                s = new TableStack<K,V>();//没有则新建
            s.tab = t;//刷新压栈的值，由于是否复用spare对以下代码复用，所以length,tab也重新刷新了一下。
            s.length = n;
            s.index = i;//更新下标
            s.next = stack;//递归引用
            stack = s;//换栈顶
        }

