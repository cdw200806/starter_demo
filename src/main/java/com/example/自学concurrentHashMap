        Segment<K,V>[] segments = (Segment<K,V>[])
            new Segment<?,?>[DEFAULT_CONCURRENCY_LEVEL];//new分段表数组
        for (int i = 0; i < segments.length; ++i)
            segments[i] = new Segment<K,V>(LOAD_FACTOR);//初始化分段表
        java.io.ObjectOutputStream.PutField streamFields = s.putFields();//使用PutField来手动定制化一些序列化的字段
        streamFields.put("segments", segments);//向后兼容，把分段涉及的三个字段手动序列化
        streamFields.put("segmentShift", segmentShift);
        streamFields.put("segmentMask", segmentMask);
