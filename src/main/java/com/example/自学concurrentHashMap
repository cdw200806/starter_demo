    /**
     * If this task's pending count is zero, returns this task;
     * otherwise decrements its pending count and returns {@code null}.
     * This method is designed to be used with {@link #nextComplete} in
     * completion traversal loops.
     *
     * @return this task, if pending count was zero, else {@code null}
     */
    public final CountedCompleter<?> firstComplete() {//这个方法来自于CountedCompleter类。通常与nextComplete一起用于结束时结果归并。
        for (int c;;) {
            if ((c = pending) == 0)//如果当前确实是完成了，返回自己。
                return this;
            else if (weakCompareAndSetPendingCount(c, c - 1))//弱cas，比起强CAS可能需要多次自旋，但是能节约CPU资源。
                return null;//没完成就返回null
        }
    }

