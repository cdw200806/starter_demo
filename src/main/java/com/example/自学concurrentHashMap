    /**
     * Replaces all linked nodes in bin at given index unless table is
     * too small, in which case resizes instead.
     */
    private final void treeifyBin(Node<K,V>[] tab, int index) {
        Node<K,V> b; int n;
        if (tab != null) {
            if ((n = tab.length) < MIN_TREEIFY_CAPACITY)
                tryPresize(n << 1);//如果不到64，比如63。执行尝试上一个size。
            else if ((b = tabAt(tab, index)) != null && b.hash >= 0) {//这个分支说明n>=64。适合树化
                synchronized (b) {//对桶加锁
                    if (tabAt(tab, index) == b) {//这个又是在做二次检查。
                        TreeNode<K,V> hd = null, tl = null;
                        for (Node<K,V> e = b; e != null; e = e.next) {//虽是树，遍历还是当链表遍历
                            TreeNode<K,V> p =
                                new TreeNode<K,V>(e.hash, e.key, e.val,
                                                  null, null);//这个就是每个节点都包装成树节点。 next/parent先不急。
                            if ((p.prev = tl) == null)//无头，记录下头
                                hd = p;
                            else
                                tl.next = p;//有头，直接续尾
                            tl = p;//新尾巴
                        }
                        setTabAt(tab, index, new TreeBin<K,V>(hd));//TreeBin hd。可以把输入的链表建树。前面看过了。
                    }
                }
            }
        }
    }
